---
// Line icons from design/final/assets/icons (stroke = currentColor).
interface Props { name: 'book'|'quill'|'candle'|'check'|'talk'|'logo'; size?: number }
const { name, size = 52 } = Astro.props;
---
{name === 'book' && <svg width={size} height={size} viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M28 15c-5-4-12-5-19-4v31c7-1 14 0 19 4 5-4 12-5 19-4V11c-7-1-14 0-19 4z"/><path d="M28 15v31"/><path d="M14 20c3-.4 6 0 8.5 1M14 26c3-.4 6 0 8.5 1M33.5 21c2.5-1 5.5-1.4 8.5-1M33.5 27c2.5-1 5.5-1.4 8.5-1"/></svg>}
{name === 'quill' && <svg width={size} height={size} viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M44 8C30 10 20 20 16 36l-3 11"/><path d="M44 8c-2 12-10 22-25 25"/><path d="M22 27c5 0 10-2 14-6"/><path d="M10 47h20"/></svg>}
{name === 'candle' && <svg width={size} height={size} viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M28 9c4 5 5 8 5 10.5a5 5 0 0 1-10 0C23 17 24 14 28 9z"/><rect x="22" y="27" width="12" height="20" rx="1.5"/><path d="M15 47h26"/><path d="M28 25v2"/><path d="M12 16l3 2M44 16l-3 2M28 3v2"/></svg>}
{name === 'talk' && <svg width={size} height={size} viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 12h28a3 3 0 0 1 3 3v15a3 3 0 0 1-3 3H20l-8 7v-7H8a3 3 0 0 1-3-3V15a3 3 0 0 1 3-3z"/><path d="M39 20h9a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3h-3v6l-7-6H30a3 3 0 0 1-3-3v-4"/><path d="M13 20h18M13 26h12"/></svg>}
{name === 'check' && <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10.5"/><path d="M7.5 12.3l3 3 6-6.3"/></svg>}
{name === 'logo' && <svg width={size} height={size} viewBox="0 0 1024 1024" aria-hidden="true"><rect width="1024" height="1024" fill="#ffffff"/><g transform="translate(512.0,512.0) scale(0.9393) translate(-0.00,86.59)"><path d="M0.00,0.00 L173.97,-193.22 A260,260 0 1 1 27.18,-258.58 Z" fill="none" stroke="#0f172a" stroke-width="54" stroke-linejoin="round" stroke-linecap="round"/><path d="M77.28,-173.57 L106.65,-453.03 A281.0,281.0 0 0 1 265.31,-382.40 Z" fill="#059669" stroke="#059669" stroke-width="12" stroke-linejoin="round"/><path d="M111.43,-337.87 H189.43 M150.43,-376.87 V-298.87" stroke="#ffffff" stroke-width="20.3" stroke-linecap="round" fill="none"/></g></svg>}
