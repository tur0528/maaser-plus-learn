---
// תיבת "נבדק על ידי הרב". מוצגת רק כשיש שם רב אמיתי ב־src/data/site.json → rav_name (או ב־Pages CMS > הגדרות האתר).
// כל עוד rav_name ריק (או נשאר עם placeholder בסוגריים), התיבה לא מוצגת בכלל.
import site from '../data/site.json';
import Icon from './Icon.astro';
const name = (site.rav_name || '').trim();
const date = (site.rav_date || '').trim();
const ready = name.length > 0 && !/[{}\[\]]/.test(name);
const dateOk = date.length > 0 && !/[{}\[\]]/.test(date);
---
{ready && (
<aside class="rav-box" aria-label="בדיקה הלכתית">
  <span class="ok"><Icon name="check" size={24} /></span>
  <div>
    <b>התוכן ההלכתי נבדק על ידי {name}</b>
    <p>{dateOk && <>תאריך הבדיקה: {date}. </>}בכל שאלה אישית מומלץ להתייעץ עם רב.</p>
  </div>
</aside>
)}
