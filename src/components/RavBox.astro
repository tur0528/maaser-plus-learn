---
// תיבת "נבדק על ידי הרב". השם והתאריך הם PLACEHOLDER גלוי עד שרב אמיתי יבדוק ויסכים להופיע בשמו.
// עורכים אותם ב־src/data/site.json (או ב־Pages CMS > הגדרות האתר).
import site from '../data/site.json';
import Icon from './Icon.astro';
const isPlaceholder = site.rav_name.includes('{');
---
<aside class={`rav-box${isPlaceholder ? ' is-placeholder' : ''}`} aria-label="בדיקה הלכתית">
  <span class="ok"><Icon name="check" size={24} /></span>
  <div>
    <b>התוכן ההלכתי נבדק על ידי {site.rav_name}</b>
    <p>תאריך הבדיקה: {site.rav_date}. בכל שאלה אישית מומלץ להתייעץ עם רב.</p>
    {isPlaceholder && <p class="ph-note">מקום שמור: השם והתאריך יוזנו רק אחרי בדיקה אמיתית.</p>}
  </div>
</aside>
