---
import Base from '../../../layouts/Base.astro';
import { enabled } from '../../../scripts/community';
---
<Base title="נושא בהתייעצויות" description="נושא בפורום ההתייעצויות של מעשר+." noindex={true}>
  <header class="page-head grain"><div class="frame" aria-hidden="true"></div><div class="wrap">
    <p class="crumbs"><a href="/forum/">התייעצויות</a></p>
    <span class="eyebrow"><i></i>התייעצויות</span>
    <h1 id="t-title">טוען…</h1>
    <div class="meta-row" id="t-meta"></div>
  </div></header>
  <section class="article"><div class="wrap narrow">
    <div class="prose post-body" id="t-body"></div>
    <h2 class="serif" style="font-weight:500;font-size:32px;margin-top:56px">תגובות</h2>
    <ul class="replies" id="t-replies"></ul>
    <form class="form" id="reply-form" style="margin-top:40px" novalidate>
      <h2>להוסיף תגובה</h2>
      {!enabled && <p class="integration-note"><b>מצב תצוגה:</b> הפורום עוד לא מחובר לשרת.</p>}
      <input type="hidden" name="topic_id" id="topic_id" />
      <div class="field"><label for="r-body">התגובה</label><textarea id="r-body" name="body" required minlength="2" maxlength="3000"></textarea></div>
      <div class="field"><label for="r-name">כינוי <span class="hint">(לא חובה)</span></label><input id="r-name" name="name" type="text" maxlength="40" /></div>
      <div class="hp" aria-hidden="true"><label>אתר<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>
      <label class="check"><input type="checkbox" name="consent" value="1" required />קראתי את <a href="/forum/#rules" style="color:var(--em);font-weight:700">כללי הפורום</a> ואת <a href="/privacy/" style="color:var(--em);font-weight:700">מדיניות הפרטיות</a>.</label>
      <div><button class="btn btn-em" type="submit">שליחה לאישור</button></div>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div></section>
  <script>
    import { enabled, call, esc, heDate, wireForm } from '../../../scripts/community';
    import demo from '../../../data/forum-examples.json';
    const id = new URLSearchParams(location.search).get('id') || '';
    (document.getElementById('topic_id') as HTMLInputElement).value = id;
    const $ = (x: string) => document.getElementById(x)!;
    const show = (t: any, isDemo: boolean) => {
      if (!t) { $('t-title').textContent = 'הנושא לא נמצא'; return; }
      document.title = `${t.title} · התייעצויות · מעשר+`;
      $('t-title').textContent = t.title;
      $('t-meta').innerHTML = `${isDemo ? '<span class="ex-badge">תוכן לדוגמה</span>' : ''}<span>${esc(t.author || 'בעילום שם')}</span><span>${heDate(t.created)}</span>`;
      $('t-body').textContent = t.body;
      const r = t.replies || [];
      $('t-replies').innerHTML = r.length ? r.map((x: any) => `<li class="reply"><div class="who">${esc(x.author || 'בעילום שם')}<span>${heDate(x.created)}</span></div><p>${esc(x.body)}</p></li>`).join('') : '<li class="empty">עדיין אין תגובות.</li>';
    };
    if (enabled) call<{ topic: any }>('forumGetTopic', { id }).then((d) => show(d.topic, false)).catch(() => show(null, false));
    else show(demo.topics.find((t) => t.id === id) ?? demo.topics[0], true);
    wireForm(document.getElementById('reply-form') as HTMLFormElement, 'forumCreateReply', (fd) => ({ topic_id: fd.get('topic_id'), body: fd.get('body'), name: fd.get('name'), consent: fd.get('consent') === '1' }), 'תודה! התגובה התקבלה ותופיע אחרי אישור.');
  </script>
</Base>
